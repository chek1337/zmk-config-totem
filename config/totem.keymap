#ifndef KEYMAP_DRAWER

#include "keys_ru.h"

#endif

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hmr_l: hmr_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
        };

        hmr_r: hmr_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
        };

        skq: skq {
            compatible = "zmk,behavior-sticky-key";
            label = "SKQ";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <2 3>;
            layers = <1>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <3 2>;
            layers = <0>;
        };

        tmux_focus {
            bindings = <&kp LC(SPACE)>;
            key-positions = <33 13>;
            layers = <1 0>;
        };

        ctrl_shift_v_ru {
            bindings = <&en LS(LC(V))>;
            key-positions = <24 21>;
            layers = <1>;
        };

        ctrl_shift_v_en {
            bindings = <&kp LS(LC(V))>;
            key-positions = <21 24>;
            layers = <0>;
        };

        ctrl_shift_c_ru {
            bindings = <&en LS(LC(C))>;
            key-positions = <21 23>;
            layers = <1>;
        };

        ctrl_shift_c_en {
            bindings = <&kp LS(LC(C))>;
            key-positions = <21 23>;
            layers = <0>;
        };

        alt_tab {
            bindings = <&kp LA(TAB)>;
            key-positions = <11 32>;
            layers = <0 1>;
        };

        capslock_one_word {
            bindings = <&caps_word>;
            key-positions = <16 18>;
            layers = <0 1>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <16 19>;
            layers = <0 1>;
        };

        window_mode_nvim {
            bindings = <&kp LC(W)>;
            key-positions = <12 33>;
            layers = <0 1>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            display-name = "En";
            bindings = <
&kp Q              &kp W              &kp E                &kp R           &kp T  &kp Y  &kp U           &kp I                 &kp O               &none
&hmr_l LEFT_GUI A  &hmr_l LEFT_ALT S  &hmr_l LEFT_SHIFT D  &hmr_l LCTRL F  &kp G  &kp H  &hmr_r RCTRL J  &hmr_r RIGHT_SHIFT K  &hmr_r RIGHT_ALT L  &hmr_r RIGHT_GUI P
&none              &kp Z              &kp X                &kp C           &kp V  &kp B  &kp N           &kp M                 &kp LBKT            &kp RBKT            &none  &kp F13
&kp TAB            &kp SPACE          &mo 6                &mo 2           &mo 4  &none
            >;
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp RU_CYRILLIC_SHORT_I         &kp RU_CYRILLIC_TSE               &kp RU_CYRILLIC_U                 &kp RU_CYRILLIC_KA          &kp RU_CYRILLIC_IE  &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE         &kp RU_CYRILLIC_SHA                &kp RU_CYRILLIC_SHCHA            &none
&hmr_l LEFT_GUI RU_CYRILLIC_EF  &hmr_l LEFT_ALT RU_CYRILLIC_YERU  &hmr_l LEFT_SHIFT RU_CYRILLIC_VE  &hmr_l LCTRL RU_CYRILLIC_A  &kp RU_CYRILLIC_PE  &kp RU_CYRILLIC_ER  &hmr_r RCTRL RU_CYRILLIC_O  &hmr_r RIGHT_SHIFT RU_CYRILLIC_EL  &hmr_r RIGHT_ALT RU_CYRILLIC_DE  &hmr_r RIGHT_GUI RU_CYRILLIC_ZHE
&none                           &kp RU_CYRILLIC_YA                &kp RU_CYRILLIC_CHE               &kp RU_CYRILLIC_ES          &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &kp RU_CYRILLIC_TE          &kp RU_CYRILLIC_SOFT_SIGN          &kp RU_CYRILLIC_BE               &kp RU_CYRILLIC_YU                &kp RU_CYRILLIC_E  &kp F13
&kp TAB                         &kp SPACE                         &mo 6                             &mo 3                       &mo 5               &none
            >;
        };

        sym_en {
            display-name = "SymEn";
            bindings = <
&kp GRAVE      &kp LESS_THAN  &kp GREATER_THAN  &kp DQT    &kp SQT   &kp AMPERSAND  &kp TILDE  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp HASH
&kp EXCL       &kp FSLH       &kp MINUS         &kp EQUAL  &kp PIPE  &kp PRCNT      &kp UNDER  &kp LPAR        &kp RPAR         &kp QMARK
&none          &kp BACKSLASH  &kp ASTERISK      &kp PLUS   &kp AT    &kp DOLLAR     &kp COMMA  &kp DOT         &kp LBKT         &kp RBKT   &kp CARET  &none
&kp SEMICOLON  &kp COLON      &mo 7             &none      &none     &none
            >;
        };

        sym_ru {
            display-name = "SymRu";
            bindings = <
&en GRAVE      &en LESS_THAN     &en GREATER_THAN  &kp RU_DQT  &en SQT   &en AMPERSAND  &en TILDE     &en LEFT_BRACE  &en RIGHT_BRACE  &en HASH
&kp EXCL       &kp RU_FSLH       &kp MINUS         &kp EQUAL   &en PIPE  &kp PRCNT      &kp UNDER     &kp LPAR        &kp RPAR         &kp RU_QMARK
&none          &kp RU_BACKSLASH  &kp ASTERISK      &kp PLUS    &en AT    &en DOLLAR     &kp RU_COMMA  &kp RU_DOT      &en LBKT         &en RBKT      &en CARET  &none
&en SEMICOLON  &en COLON         &mo 7             &none       &none     &none
            >;
        };

        num_nav_en {
            display-name = "NumNavEn";
            bindings = <
&kp N6  &kp N7           &kp N8     &kp N9    &kp N0   &mkp RCLK   &kp RS(ENTER)  &kp RC(DELETE)  &kp DELETE  &kp PRINTSCREEN
&kp N1  &kp N2           &kp N3     &kp N4    &kp N5   &mkp LCLK   &kp ENTER      &kp RC(BSPC)    &kp BSPC    &kp ESC
&none   &kp PAGE_DOWN    &kp PG_UP  &kp HOME  &kp END  &kp ESCAPE  &kp COMMA      &kp DOT         &kp LBKT    &kp RBKT         &none  &none
&none   &skq LEFT_SHIFT  &none      &none     &none    &none
            >;
        };

        num_nav_ru {
            display-name = "NumNavRu";
            bindings = <
&kp N6  &kp N7           &kp N8     &kp N9    &kp N0   &mkp RCLK   &kp RS(ENTER)  &kp RC(DELETE)  &kp DELETE          &kp PRINTSCREEN
&kp N1  &kp N2           &kp N3     &kp N4    &kp N5   &mkp LCLK   &kp ENTER      &kp RC(BSPC)    &kp BSPC            &kp ESC
&none   &kp PAGE_DOWN    &kp PG_UP  &kp HOME  &kp END  &kp ESCAPE  &en COMMA      &en DOT         &kp RU_CYRILLIC_HA  &kp RU_CYRILLIC_HARD_SIGN  &kp RU_CYRILLIC_IO  &none
&none   &skq LEFT_SHIFT  &none      &none     &none    &none
            >;
        };

        nav {
            display-name = "ArrowsFs";
            bindings = <
&kp F1  &kp F2  &kp F3   &kp F4   &none      &kp RS(RC(LEFT))  &kp RC(RS(DOWN))  &kp RC(RS(UP))  &kp RC(RS(RIGHT))  &none
&kp F5  &kp F6  &kp F7   &kp F8   &kp ENTER  &kp LEFT          &kp DOWN          &kp UP          &kp RIGHT          &none
&none   &kp F9  &kp F10  &kp F11  &kp F12    &kp ESCAPE        &kp RC(LEFT)      &kp RC(DOWN)    &kp RC(UP)         &kp RC(RIGHT)  &none  &none
&none   &none   &none    &mo 7    &none      &none
            >;
        };

        adj {
            display-name = "Control";
            bindings = <
&none        &none  &none  &none  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3      &bt BT_SEL 4
&none        &none  &none  &none  &none  &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE    &kp C_VOL_UP      &kp PRINTSCREEN
&bootloader  &none  &none  &none  &none  &none         &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT       &studio_unlock  &bt BT_CLR
&none        &none  &none  &none  &none  &none
            >;
        };
    };
};
